# Copy to .env and fill in what you need.

# --- API keys for the agent (only the provider you use) ---
# The SDKs read these; --openai-api-key on the CLI overrides OPENAI_API_KEY.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- Benchmark server (app.py) ---
# Comma-separated puzzle directories to serve.
CAPTCHA_DATA_DIRS=data/Test
# CAPTCHA_PORT=7860

# --- Dataset gallery (gallery/app.py) ---
# GALLERY_DATA_ROOT=data
# GALLERY_CAPTCHA_URL=http://127.0.0.1:7860
# GALLERY_PORT=48040
# GALLERY_THUMB_CACHE=/tmp/captcha_arena_thumbs

# --- Agent behaviour (optional) ---
# CU_LLM_TIMEOUT_S=180
# CU_MAX_TOKENS=2048
# KEEP_IMG_TURNS=3           # screenshots kept in context per turn
# SFT_EVAL_NATIVE=1          # use the 5-tool no-done schema that matches SFT data
